# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tokoonline?schema=public"

# Midtrans Sandbox credentials. Never expose these in browser code.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# Public base URL, e.g. https://your-store.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
